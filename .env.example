# ============================================================
# Vilasa Cafe — FRONTEND environment (.env)
# ONLY public / client-safe values. These are bundled into the
# browser build, so NEVER put secrets here (no service role key,
# no R2 secret). Vite only exposes vars prefixed with VITE_.
# ============================================================

# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API base URL (no trailing slash). The client appends /api.
VITE_API_URL=http://localhost:4000
